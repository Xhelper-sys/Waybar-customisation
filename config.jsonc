{
  "position": "top",
  "output":"eDP-1",
  "name":"hello",
  
  "modules-left":[
    "sway/workspaces", 
    "sway/window"
  ],

  "modules-center":[
    "sway/language", 
    "temperature", 
    "memory", 
    "cpu", 

    "custom/archlogo",

    "clock",
    "custom/timewatch",
    "network",
    "bluetooth",
    "custom/notification"
  ],
  
  "modules-right":[
    "pulseaudio",
    "custom/brightness",
    "battery"
  ],


  // workspaces 

  "sway/workspaces":{
    "all-outputs":false,
    "format":"{icon}",
     "format-icons": {
      "default": "",
      "focused": ""
    },
    "disable-scroll":false,
    "everse-scroll":false,
    "disable-click":false,
    "current-only":false,
    "format-window-separator": " | "
  },

  // hyprland/window

  "sway/window":{
    "format":"{title}",
    "max-length":28,
    "separate-outputs":true,
    "fallback":"Nothing",
    "icon":true,
    "icon-size": 15,
    "expand": false
  },

  // language

  "sway/language":{
    "format":"{short}"
    // Not work with the css atribut:value (margin:-?px)
    // "hide-single-layout":false,
    // "tooltip":true,
    //"tooltip-format":"{long}"
  },

  // temperature

  "temperature":{
    "warning-threshold":80,
    "critical-threshold":95,
    "interval":10,
    "format-warning":"{icon} {temperatureC}°C",
    "format-critical":"{icon} {temperatureC}°C",
    "format":"󱃃 {temperatureC}°C",
    "format-icons": [
      "󰸁",
      "󱃂"
    ],
    "tooltip-format":"{temperatureC}°C",
    "justify":"center",
    "tooltip":true,
    "expend":false
  },

  // memory
  
  "memory":{
    "interval":30,
    "format":"󰘚 {percentage}%",
    "justify":"center",
    "tooltip":true,
    "tooltip-format":"{used:0.1f}GiB used",
    "unit":"GiB"
  },

  // cpu

  "cpu":{
    "interval":10,
    "format":" {usage}%",
    "justify":"center"
  },

  // custom archlogo

  "custom/archlogo":{
    "format":"󰣇"
  },

  // clock

  "clock":{
    "interval":60,
    "format":" {:%H:%M}",
    "timezones":"",
    "tooltip":true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
	  "calendar": {
		  "mode"             : "year",
		  "mode-mon-col"     : 3,
		  "weeks-pos"        : "right",
		  "first-day-of-week": 1,
		  "on-scroll"        : 1,
		  "on-click-right"   : "mode",
		  "format": {
			  "months":     "<span color='#ffead3'><b>{}</b></span>",
			  "days":       "<span color='#ecc6d9'><b>{}</b></span>",
			  "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
			  "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
			  "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
		  }
	  }
  },

  // timewatch

  "custom/timewatch":{
    "format":"󰈈 {text}",
    "exec": "$HOME/.config/waybar/script-custom/timewatch.sh 2> /dev/null",
    "interval":60,
    "justify":"center",
    "tooltip":true,
    "tooltip-format":"{text}"
  },

  // network

  "network":{
    "rfkill":true,
    "interval": 60,
    "family":"ipv4_6",
    "format":"",
    "format-ethernet":"󰈁",
    "format-wifi":"",
    "format-linked":"󱎔",
    "format-disconnected":"󰖪",
    "format-disabled":"",
    "justify":"center",
    "tooltip":true,
    "tooltip-format":"<span color='#98D549'><span color='#0ABD31'>Name:</span> {ifname}</span>",
    "tooltip-format-wifi": "<span color='#98D549'><span color='#0ABD31'>Name:</span> {ifname}</span>\n\n<span color='#98D549'><span color='#0ABD31'>First IP:</span> {ipaddr}</span>\n<span color='#98D549'><span color='#0ABD31'>The default gateway:</span> {gwaddr}</span>\n\n<span color='#98D549'><span color='#0ABD31'>Name (SSID):</span> {essid}</span>\n\n<span color='#98D549'><span color='#0ABD31'>MAC address (BSSID):</span> {bssid}</span>\n\n<span color='#98D549'><span color='#0ABD31'>Signal strength:</span> {signalStrength}%</span>\n\n<span color='#98D549'><span color='#0ABD31'>Frequency:</span> {frequency}GHz</span>",
    "tooltip-format-ethernet":"<span color='#98D549'><span color='#0ABD31'>Name:</span> {ifname}</span><span color='#98D549'><span color='#0ABD31'>Ethernet link speed:</span>{linkSpeed}</span>",
    "tooltip-format-disconnected":"<span color='#fe3c3c'>no connection</span>",
    "tooltip-format-disabled":"<span color='#3c8dfe'>󰀝 airplane mode</span>"
  },

  // bluetooth

  "bluetooth":{}

}
